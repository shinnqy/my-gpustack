# Linux only: docker-compose.server.yaml uses the host network.
# Match the image built by make package; a local dev image is not pulled.
IMAGE_REGISTRY=docker.io
IMAGE_NAMESPACE=gpustack
GPUSTACK_TAG=dev
# Optional full image override, including a custom PACKAGE_REPOSITORY:
# GPUSTACK_IMAGE=registry.example.com/team/my-gpustack:chapter15

# Required: use the same database URL as an existing source-started Server.
# Example: postgresql://user:password@127.0.0.1:5432/gpustack
GPUSTACK_DATABASE_URL=

# Required: use this Linux host's address reachable by Kubernetes Workers.
# Example: http://100.107.227.30:30080
GPUSTACK_SERVER_EXTERNAL_URL=
GPUSTACK_API_PORT=30080

# Fresh installation: a Docker named volume, like the original project.
# Migration: replace this with the existing Server's absolute data directory.
# Ascend example: /data2/qy/scheduling/tmp/gpustack-server
GPUSTACK_SERVER_DATA_DIR=gpustack-data

# Optional, for bootstrapping a new default cluster. Existing installations
# normally leave this unset and reuse their data-directory token.
# GPUSTACK_TOKEN=bootstrap
